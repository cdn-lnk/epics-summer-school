record(motor, "$(P):LensRotation") {
    field(DESC, "Motor record for Lens rotation")
    field(SCAN, "Passive")
    field(DTYP, "asynMotor")
		field(OUT, "@asyn($(port), $(axis_number))")
    field(VELO, "0.1")
    field(RDBD, "0.01")
}

